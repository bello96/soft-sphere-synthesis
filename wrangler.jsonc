{
  // Cloudflare Workers static assets: the game is plain files, no server code.
  // What gets uploaded is controlled by .assetsignore (only the game itself is served).
  "name": "soft-sphere-synthesis",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "soft-synthesis.dengjiabei.cn",
      "custom_domain": true
    }
  ]
}
